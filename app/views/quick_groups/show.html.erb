<h1>Groupe <%= @group.name %> - Classement rapide</h1>

<p><%= link_to "Retour", simulation_path(token: @simulation.token) %></p>

<p>Glissez-deposez les equipes pour definir le classement :</p>

<%= form_with url: update_quick_group_path(token: @simulation.token, name: @group.name), method: :patch, id: "ranking-form" do |f| %>

  <div data-controller="sortable" data-sortable-target="list" style="max-width: 400px;">
    <% @teams.each_with_index do |team, index| %>
      <div data-sortable-target="item"
           data-team-id="<%= team.id %>"
           style="padding: 15px; margin: 5px 0; background: #f8f9fa; border: 3px solid <%= index < 2 ? '#28a745' : (index == 2 ? '#fd7e14' : '#dc3545') %>; border-radius: 8px; cursor: grab; display: flex; align-items: center; gap: 12px; user-select: none; transition: all 0.2s ease;">
        <span data-rank style="font-weight: bold; width: 30px; font-size: 18px;"><%= index + 1 %>.</span>
        <%= flag_icon(team) %>
        <span style="font-size: 16px;"><%= team.name %></span>
        <input type="hidden" name="team_ids[]" value="<%= team.id %>">
      </div>
    <% end %>
  </div>

  <div style="margin-top: 20px;">
    <p><strong>Legende :</strong></p>
    <ul>
      <li style="color: #28a745;">1er et 2eme : Qualifies directement</li>
      <li style="color: #fd7e14;">3eme : Peut se qualifier parmi les meilleurs 3emes</li>
      <li style="color: #dc3545;">4eme : Elimine</li>
    </ul>
  </div>

  <div style="margin-top: 20px;">
    <%= f.submit "Valider ce classement", style: "padding: 12px 24px; font-size: 16px; background: #007bff; color: white; border: none; border-radius: 6px; cursor: pointer;" %>
  </div>

<% end %>

<style>
  [data-sortable-target="item"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
  }
  [data-sortable-target="item"].dragging {
    opacity: 0.5;
    cursor: grabbing;
  }
  .fi {
    font-size: 24px;
  }
</style>