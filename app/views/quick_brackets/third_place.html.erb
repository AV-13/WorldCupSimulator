<% content_for :title, "#{t('third_place.title')} #{t('third_place.title_highlight')} - #{t('simulation.mode_express')}" %>

<div class="page">
  <%= page_title_bar t('third_place.title'), highlight: t('third_place.title_highlight') %>

  <main class="page-content">
    <%= back_link quick_bracket_path(token: @simulation.token), t('third_place.back') %>

    <section class="page-section">
      <h2 class="section-title"><%= t('third_place.selection_title') %></h2>
      <p class="text-muted mb-md"><%= t('third_place.instruction') %></p>

      <%= form_with url: update_quick_third_place_path(token: @simulation.token), method: :patch do |f| %>

        <div class="third-place-grid">
          <% @all_thirds.each_with_index do |third, i| %>
            <% is_qualifying = @current_qualifying.include?(third.group) %>
            <label class="third-place-item <%= is_qualifying ? 'selected' : '' %>">
              <input type="checkbox"
                     name="qualifying_groups[]"
                     value="<%= third.group %>"
                     <%= 'checked' if is_qualifying %>
                     onchange="updateSelection(this)">
              <div class="third-place-info">
                <strong><%= t('simulation.group') %> <%= third.group %></strong>
                <% if third.team %>
                  <span style="display: flex; align-items: center; gap: 8px; margin-left: 12px;">
                    <%= flag_icon(third.team) %>
                    <%= team_info_link(third.team) %>
                  </span>
                <% else %>
                  <span class="bracket-tbd" style="margin-left: 12px;"><%= t('bracket.tbd') %></span>
                <% end %>
              </div>
              <div class="third-place-stats">
                <div><strong><%= third.points %></strong> <%= t('simulation.pts') %></div>
                <div style="font-size: 0.8rem;"><%= third.goal_diff > 0 ? "+#{third.goal_diff}" : third.goal_diff %> <%= t('third_place.diff') %></div>
              </div>
            </label>
          <% end %>
        </div>

        <div class="selection-counter" id="selection-counter">
          <span><%= t('third_place.counter') %> : </span>
          <span class="count" id="selection-count"><%= @current_qualifying.length %></span>
          <span> / 8 <%= t('third_place.groups_suffix') %></span>
        </div>

        <div class="mt-lg text-center">
          <%= f.submit t('third_place.submit'), id: "submit-btn", class: "btn btn-emerald" %>
        </div>

      <% end %>
    </section>
  </main>
</div>

<script>
  function updateSelection(checkbox) {
    const checkboxes = document.querySelectorAll('input[name="qualifying_groups[]"]');
    const checked = document.querySelectorAll('input[name="qualifying_groups[]"]:checked');
    const count = checked.length;

    document.getElementById('selection-count').textContent = count;

    const counter = document.getElementById('selection-counter');
    const submitBtn = document.getElementById('submit-btn');

    counter.classList.remove('valid', 'invalid', 'over');

    if (count === 8) {
      submitBtn.disabled = false;
      counter.classList.add('valid');
    } else if (count > 8) {
      submitBtn.disabled = true;
      counter.classList.add('over');
    } else {
      submitBtn.disabled = true;
      counter.classList.add('invalid');
    }

    // Update item styles
    checkboxes.forEach(function(cb) {
      const item = cb.closest('.third-place-item');
      if (cb.checked) {
        item.classList.add('selected');
      } else {
        item.classList.remove('selected');
      }
    });
  }

  // Initial state
  document.addEventListener('DOMContentLoaded', function() {
    const checked = document.querySelectorAll('input[name="qualifying_groups[]"]:checked');
    const count = checked.length;
    const counter = document.getElementById('selection-counter');
    const submitBtn = document.getElementById('submit-btn');

    if (count === 8) {
      counter.classList.add('valid');
      submitBtn.disabled = false;
    } else if (count > 8) {
      counter.classList.add('over');
      submitBtn.disabled = true;
    } else {
      counter.classList.add('invalid');
      submitBtn.disabled = true;
    }
  });
</script>
