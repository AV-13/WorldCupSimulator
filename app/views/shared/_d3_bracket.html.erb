<%#
  D3.js Bracket Visualization

  Local variables:
  - matches_by_round: Hash with matches grouped by round
  - predictions: Hash with predictions indexed by match_id
  - simulation: Current simulation
  - quick_mode: Boolean - if true, teams are clickable to select winner
%>

<%
  bracket_data = bracket_json_data(matches_by_round, predictions, simulation, quick_mode)
  final_match = matches_by_round['final']&.first
  final_prediction = predictions[final_match&.id] if final_match
  champion = if final_prediction&.home_score && final_prediction&.away_score
    final_prediction.home_score > final_prediction.away_score ? final_match.home_team : final_match.away_team
  end
%>

<div id="bracket-container"
     class="d3-bracket-container"
     data-controller="bracket"
     data-bracket-target="container"
     data-bracket-data-value="<%= bracket_data.to_json %>"
     data-bracket-knockout-path-value="<%= knockout_match_path(token: simulation.token, match_number: '__MATCH__') %>"
     data-bracket-quick-winner-path-value="<%= set_quick_winner_path(token: simulation.token, match_number: '__MATCH__', winner_team_id: '__TEAM__') %>">

  <%# Zoom controls %>
  <div class="bracket-zoom-controls" data-bracket-target="zoomControls">
    <button type="button" class="bracket-zoom-btn" data-action="click->bracket#zoomIn" title="<%= t('bracket.zoom_in', default: 'Zoom in') %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="11" y1="8" x2="11" y2="14"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </button>
    <button type="button" class="bracket-zoom-btn" data-action="click->bracket#zoomOut" title="<%= t('bracket.zoom_out', default: 'Zoom out') %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </button>
    <button type="button" class="bracket-zoom-btn" data-action="click->bracket#zoomReset" title="<%= t('bracket.zoom_reset', default: 'Reset view') %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
    </button>
  </div>

  <%# Main SVG canvas %>
  <svg data-bracket-target="svg" class="d3-bracket-svg">
    <defs>
      <%# Final match gradient %>
      <linearGradient id="finalGradient" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="rgba(26, 47, 35, 0.8)" />
        <stop offset="100%" stop-color="rgba(26, 26, 26, 0.95)" />
      </linearGradient>

      <%# Gold glow filter %>
      <filter id="goldGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="3" result="blur" />
        <feFlood flood-color="rgba(196, 167, 125, 0.6)" result="color" />
        <feComposite in="color" in2="blur" operator="in" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <%# Winner highlight filter %>
      <filter id="winnerGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="2" result="blur" />
        <feFlood flood-color="rgba(61, 107, 79, 0.5)" result="color" />
        <feComposite in="color" in2="blur" operator="in" result="glow" />
        <feMerge>
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <%# Connector gradient %>
      <linearGradient id="connectorGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="rgba(196, 167, 125, 0.3)" />
        <stop offset="100%" stop-color="rgba(196, 167, 125, 0.15)" />
      </linearGradient>

      <%# Active connector gradient %>
      <linearGradient id="activeConnectorGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#c4a77d" />
        <stop offset="100%" stop-color="#d4bc96" />
      </linearGradient>
    </defs>
  </svg>

  <%# Champion celebration overlay %>
  <% if champion %>
    <div class="bracket-champion-overlay" data-bracket-target="championOverlay">
      <div class="bracket-champion-content">
        <div class="bracket-trophy-icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
            <path d="M4 22h16"/>
            <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
            <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
          </svg>
        </div>
        <div class="bracket-champion-flag">
          <%= flag_icon(champion, size: :large) %>
        </div>
        <div class="bracket-champion-name"><%= champion.name %></div>
        <div class="bracket-champion-label"><%= t('bracket.world_champion', default: 'World Champion').upcase %></div>
      </div>
    </div>
  <% end %>

  <%# Confetti canvas %>
  <canvas data-bracket-target="confetti" class="bracket-confetti-canvas"></canvas>

  <%# Loading state %>
  <div class="bracket-loading" data-bracket-target="loading">
    <div class="bracket-loading-spinner"></div>
  </div>
</div>
