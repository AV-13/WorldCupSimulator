<% content_for :title, "#{t('groups.title')} #{@group.name} - #{t('simulation.mode_express')}" %>

<div class="page">
  <%= page_title_bar t('groups.title'), highlight: @group.name %>

  <main class="page-content">
    <%= back_link simulation_path(token: @simulation.token), t('groups.back') %>

    <section class="page-section">
      <h2 class="section-title"><%= t('groups.rankings') %></h2>
      <p class="text-muted mb-md"><%= t('groups.drag_instruction') %></p>

      <%= form_with url: update_quick_group_path(token: @simulation.token, name: @group.name), method: :patch, id: "ranking-form", class: "ranking-form" do |f| %>
        <div class="ranking-main">
          <div class="ranking-list" data-controller="sortable" data-sortable-target="list">
            <% @teams.each_with_index do |team, index| %>
              <div class="ranking-item position-<%= index + 1 %>"
                   data-sortable-target="item"
                   data-team-id="<%= team.id %>">
                <span class="ranking-position" data-rank><%= index + 1 %></span>
                <div class="ranking-team">
                  <%= flag_icon(team) %>
                  <%= lineup_icon(team, @simulation) %>
                </div>
                <span class="ranking-handle">⋮⋮</span>
                <input type="hidden" name="team_ids[]" value="<%= team.id %>">
              </div>
            <% end %>
          </div>

          <div class="ranking-submit">
            <%= f.submit t('groups.confirm_rankings'), class: "btn btn-gold btn-block" %>
          </div>
        </div>

        <div class="ranking-legend">
          <h4><%= t('groups.legend.title') %></h4>
          <ul>
            <li class="legend-qualified"><%= t('groups.legend.qualified') %></li>
            <li class="legend-playoff"><%= t('groups.legend.playoff') %></li>
            <li class="legend-eliminated"><%= t('groups.legend.eliminated') %></li>
          </ul>
        </div>
      <% end %>
    </section>
  </main>
</div>
