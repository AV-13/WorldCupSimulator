<h1>Phase finale - Mode rapide</h1>

<p><%= link_to "Retour", simulation_path(token: @simulation.token) %></p>

<% unless @qualification[:complete] %>
  <div style="background: #fff3cd; padding: 10px; margin-bottom: 20px; border: 1px solid #ffc107;">
    <strong>Attention :</strong> Completez d'abord le classement de tous les groupes.
    <br>
    <%= link_to "Modifier les meilleurs 3emes", quick_third_place_path(token: @simulation.token) %>
  </div>
<% end %>

<h2>Classement des 3emes</h2>
<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Rang</th>
      <th>Groupe</th>
      <th>Equipe</th>
      <th>Statut</th>
    </tr>
  </thead>
  <tbody>
    <% @qualification[:all_thirds].each_with_index do |third, i| %>
      <tr style="<%= i < 8 ? 'background-color: #d4edda;' : 'background-color: #f8d7da;' %>">
        <td><%= i + 1 %></td>
        <td><%= third.group %></td>
        <td>
          <% if third.team %>
            <%= flag_icon(third.team) %> <%= third.team.name %>
          <% else %>
            TBD
          <% end %>
        </td>
        <td><%= i < 8 ? "Qualifie" : "Elimine" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p style="margin-top: 10px;">
  <%= link_to "Modifier la selection des 3emes", quick_third_place_path(token: @simulation.token) %>
</p>

<hr>

<% if @knockout_matches.any? %>
  <h2>Tableau final</h2>
  <p><em>Cliquez sur une equipe pour la designer comme vainqueur</em></p>

  <div id="bracket-container">
    <%= render "bracket" %>
  </div>

<% else %>
  <p><em>Le bracket sera genere une fois tous les groupes classes.</em></p>
<% end %>