<% content_for :title, "Groupe #{@group.name} - Mode Rapide" %>

<div class="page">
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title">GROUPE <span><%= @group.name %></span></h1>
      <div class="mode-badge mode-quick">⚡ Mode Rapide</div>
    </div>
  </header>

  <main class="page-content">
    <%= link_to simulation_path(token: @simulation.token), class: "back-link" do %>
      Retour aux groupes
    <% end %>

    <section class="page-section">
      <h2 class="section-title">Classement du groupe</h2>
      <p class="text-muted mb-md">Glissez-déposez les équipes pour définir le classement :</p>

      <%= form_with url: update_quick_group_path(token: @simulation.token, name: @group.name), method: :patch, id: "ranking-form", class: "ranking-form" do |f| %>

        <div class="ranking-list" data-controller="sortable" data-sortable-target="list">
          <% @teams.each_with_index do |team, index| %>
            <div class="ranking-item position-<%= index + 1 %>"
                 data-sortable-target="item"
                 data-team-id="<%= team.id %>">
              <span class="ranking-position" data-rank><%= index + 1 %></span>
              <div class="ranking-team">
                <%= flag_icon(team) %>
                <span><%= team.name %></span>
              </div>
              <span class="ranking-handle">⋮⋮</span>
              <input type="hidden" name="team_ids[]" value="<%= team.id %>">
            </div>
          <% end %>
        </div>

        <div class="ranking-legend">
          <h4>LÉGENDE</h4>
          <ul>
            <li class="legend-qualified">1er et 2ème : Qualifiés directement</li>
            <li class="legend-playoff">3ème : Peut se qualifier parmi les meilleurs 3èmes</li>
            <li class="legend-eliminated">4ème : Éliminé</li>
          </ul>
        </div>

        <div class="mt-lg">
          <%= f.submit "Valider ce classement", class: "btn btn-emerald" %>
        </div>

      <% end %>
    </section>
  </main>
</div>
