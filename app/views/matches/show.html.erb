<% content_for :title, "#{@match.home_team.name} vs #{@match.away_team.name} - #{t('site.description')}" %>

<div class="page">
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title"><%= t('match.title').upcase %> <span><%= @match.group&.name %></span></h1>
    </div>
  </header>

  <main class="page-content">
    <%= link_to group_path(@simulation.token, @match.group.name), class: "back-link" do %>
      <%= t('match.back', name: @match.group.name) %>
    <% end %>

    <div class="prediction-form">
      <div class="prediction-card">
        <%= form_with model: @prediction,
                      url: update_match_path(@simulation.token, @match.id),
                      method: :patch do |f| %>

          <div class="prediction-teams">
            <div class="prediction-team">
              <%= flag_icon(@match.home_team, size: :large) %>
              <div class="team-name"><%= @match.home_team.name %></div>
              <%= f.number_field :home_score, min: 0, max: 20, placeholder: "0" %>
            </div>

            <div class="prediction-separator">-</div>

            <div class="prediction-team">
              <%= flag_icon(@match.away_team, size: :large) %>
              <div class="team-name"><%= @match.away_team.name %></div>
              <%= f.number_field :away_score, min: 0, max: 20, placeholder: "0" %>
            </div>
          </div>

          <div class="prediction-submit">
            <%= f.submit t('match.save'), class: "btn btn-gold" %>
          </div>

        <% end %>
      </div>
    </div>
  </main>
</div>
