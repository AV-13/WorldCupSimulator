<% content_for :title, "#{t('groups.title')} #{@group.name} - #{t('site.description')}" %>

<div class="page">
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title"><%= t('groups.title').upcase %> <span><%= @group.name %></span></h1>
    </div>
  </header>

  <main class="page-content">
    <%= link_to simulation_path(@simulation.token), class: "back-link" do %>
      <%= t('groups.back') %>
    <% end %>

    <!-- Standings Table -->
    <section class="page-section">
      <h2 class="section-title"><%= t('groups.standings') %></h2>

      <div class="table-container">
        <table class="standings-table group-standings-table">
          <thead>
            <tr>
              <th class="col-rank">#</th>
              <th class="col-team"><%= t('groups.table.team') %></th>
              <th class="col-stat"><%= t('groups.table.played') %></th>
              <th class="col-stat"><%= t('groups.table.won') %></th>
              <th class="col-stat"><%= t('groups.table.drawn') %></th>
              <th class="col-stat"><%= t('groups.table.lost') %></th>
              <th class="col-stat"><%= t('groups.table.gf') %></th>
              <th class="col-stat"><%= t('groups.table.ga') %></th>
              <th class="col-stat"><%= t('groups.table.gd') %></th>
              <th class="col-stat col-pts"><%= t('groups.table.pts') %></th>
            </tr>
          </thead>
          <tbody>
            <% @standings.each_with_index do |row, i| %>
              <tr class="position-<%= i + 1 %>">
                <td class="rank-cell"><%= i + 1 %></td>
                <td class="team-cell">
                  <%= flag_icon(row.team) %>
                  <span><%= row.team.name %></span>
                  <%= lineup_icon(row.team, @simulation) %>
                </td>
                <td class="stat-cell"><%= row.played %></td>
                <td class="stat-cell"><%= row.wins %></td>
                <td class="stat-cell"><%= row.draws %></td>
                <td class="stat-cell"><%= row.losses %></td>
                <td class="stat-cell"><%= row.goals_for %></td>
                <td class="stat-cell"><%= row.goals_against %></td>
                <td class="stat-cell <%= row.goal_diff > 0 ? 'diff-positive' : (row.goal_diff < 0 ? 'diff-negative' : '') %>">
                  <%= row.goal_diff > 0 ? "+#{row.goal_diff}" : row.goal_diff %>
                </td>
                <td class="stat-cell points-cell"><%= row.points %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="ranking-legend mt-md">
        <h4><%= t('groups.legend.title').upcase %></h4>
        <ul>
          <li class="legend-qualified"><%= t('groups.legend.qualified') %></li>
          <li class="legend-playoff"><%= t('groups.legend.playoff') %></li>
          <li class="legend-eliminated"><%= t('groups.legend.eliminated') %></li>
        </ul>
      </div>
    </section>

    <!-- Matches List -->
    <section class="page-section">
      <h2 class="section-title"><%= t('groups.matches') %></h2>

      <% completed_count = @predictions_by_match_id.values.count { |p| p&.home_score && p&.away_score } %>
      <div class="match-progress">
        <span class="match-progress-label"><%= t('groups.progress') %></span>
        <span class="match-progress-count"><%= completed_count %>/<%= @matches.count %></span>
        <div class="match-progress-bar">
          <div class="match-progress-fill" style="width: <%= (@matches.count > 0 ? completed_count.to_f / @matches.count * 100 : 0).round %>%"></div>
        </div>
        <% if completed_count == @matches.count %>
          <span class="completion-badge"><%= t('groups.complete') %></span>
        <% end %>
      </div>

      <div class="matches-list">
        <% @matches.each do |m| %>
          <% p = @predictions_by_match_id[m.id] %>
          <% has_score = p&.home_score && p&.away_score %>
          <div class="match-item <%= has_score ? 'match-completed' : 'match-pending' %>">
            <div class="match-teams">
              <div class="match-team home">
                <span><%= m.home_team.name %></span>
                <%= flag_icon(m.home_team) %>
              </div>
              <% if has_score %>
                <div class="match-score"><%= p.home_score %> - <%= p.away_score %></div>
              <% else %>
                <div class="match-vs"><%= t('groups.vs') %></div>
              <% end %>
              <div class="match-team away">
                <%= flag_icon(m.away_team) %>
                <span><%= m.away_team.name %></span>
              </div>
            </div>
            <div class="match-action">
              <% if has_score %>
                <%= link_to t('groups.edit'), match_path(@simulation.token, m.id) %>
              <% else %>
                <%= link_to "#{t('groups.predict')} →", match_path(@simulation.token, m.id), class: "btn btn-sm btn-gold" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </main>
</div>
