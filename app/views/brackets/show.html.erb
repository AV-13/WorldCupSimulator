<% content_for :title, "#{t('bracket.title')} #{t('bracket.title_highlight')} - #{t('site.description')}" %>

<div class="page">
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title"><%= t('bracket.title').upcase %> <span><%= t('bracket.title_highlight').upcase %></span></h1>
      <div class="mode-badge mode-complete"><%= t('simulation.mode_complete') %></div>
    </div>
  </header>

  <main class="page-content">
    <%= link_to simulation_path(token: @simulation.token), class: "back-link" do %>
      <%= t('bracket.back') %>
    <% end %>

    <% unless @qualification[:complete] %>
      <div class="alert alert-warning mb-lg">
        <span class="alert-icon">⚠️</span>
        <div class="alert-content">
          <strong><%= t('bracket.incomplete_alert') %></strong>
          <%= t('bracket.incomplete_message') %>
          <br>
          <small><%= t('bracket.predictions_count') %> : <%= Prediction.where(simulation: @simulation).where.not(home_score: nil).count %> / 72</small>
        </div>
      </div>
    <% end %>

    <!-- Bracket Tree Visualization -->
    <% if @knockout_matches.any? %>
      <section class="page-section">
        <h2 class="section-title"><%= t('bracket.tree') %></h2>
        <p class="text-muted mb-md"><%= t('bracket.click_instruction') %></p>

        <%= render 'shared/d3_bracket',
                   matches_by_round: @matches_by_round,
                   predictions: @predictions,
                   simulation: @simulation,
                   quick_mode: false %>
      </section>
    <% end %>

    <!-- Third Place Rankings Table -->
    <section class="page-section">
      <h2 class="section-title"><%= t('bracket.third_place_title') %></h2>
      <p class="text-muted mb-md"><%= t('bracket.third_place_info') %></p>

      <div class="table-container">
        <table class="standings-table thirds-table">
          <thead>
            <tr>
              <th class="col-rank"><%= t('bracket.table.rank') %></th>
              <th class="col-group"><%= t('bracket.table.group') %></th>
              <th class="col-team"><%= t('bracket.table.team') %></th>
              <th class="col-stat"><%= t('bracket.table.pts') %></th>
              <th class="col-stat"><%= t('bracket.table.diff') %></th>
              <th class="col-status"><%= t('bracket.table.status') %></th>
            </tr>
          </thead>
          <tbody>
            <% @qualification[:all_thirds].each_with_index do |third, i| %>
              <tr class="<%= i < 8 ? 'row-qualified' : 'row-eliminated' %>">
                <td class="rank-cell"><%= i + 1 %></td>
                <td class="group-cell"><%= t('simulation.group') %> <%= third.group %></td>
                <td class="team-cell">
                  <% if third.team %>
                    <%= flag_icon(third.team) %>
                    <span><%= third.team.name %></span>
                  <% else %>
                    <span class="bracket-tbd"><%= t('bracket.tbd') %></span>
                  <% end %>
                </td>
                <td class="stat-cell points-cell"><%= third.points %></td>
                <td class="stat-cell <%= third.goal_diff > 0 ? 'diff-positive' : (third.goal_diff < 0 ? 'diff-negative' : '') %>">
                  <%= third.goal_diff > 0 ? "+#{third.goal_diff}" : third.goal_diff %>
                </td>
                <td class="status-cell">
                  <% if i < 8 %>
                    <span class="status-badge status-qualified">✓ <%= t('bracket.qualified') %></span>
                  <% else %>
                    <span class="status-badge status-eliminated">✗ <%= t('bracket.eliminated') %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Match List -->
    <% if @knockout_matches.any? %>
      <section class="page-section">
        <h2 class="section-title"><%= t('bracket.match_details') %></h2>

        <% %w[round_of_32 round_of_16 quarter_final semi_final third_place final].each do |round| %>
          <% matches = @matches_by_round[round] %>
          <% next unless matches&.any? %>

          <div class="bracket-section">
            <h3 class="bracket-round-title"><%= t("bracket.rounds.#{round.gsub('round_of_', 'r')}") %></h3>

            <div class="bracket-matches">
              <% matches.each do |match| %>
                <% prediction = @predictions[match.id] %>
                <% has_score = prediction&.home_score && prediction&.away_score %>
                <% winner = has_score ? (prediction.home_score > prediction.away_score ? match.home_team : (prediction.away_score > prediction.home_score ? match.away_team : match.home_team)) : nil %>

                <div class="bracket-match">
                  <div class="bracket-match-header">
                    <span><%= t('bracket.match_number') %> #<%= match.match_number %></span>
                    <% if match.teams_known? && !has_score %>
                      <%= link_to t('groups.predict'), knockout_match_path(token: @simulation.token, match_number: match.match_number) %>
                    <% elsif has_score %>
                      <%= link_to t('groups.edit'), knockout_match_path(token: @simulation.token, match_number: match.match_number) %>
                    <% end %>
                  </div>
                  <div class="bracket-match-content">
                    <div class="bracket-team <%= winner == match.home_team ? 'winner' : '' %>">
                      <div class="bracket-team-info">
                        <% if match.home_team %>
                          <%= flag_icon(match.home_team) %>
                          <span><%= match.home_team.name %></span>
                          <%= lineup_icon(match.home_team, @simulation, match: match) %>
                        <% else %>
                          <span class="bracket-tbd"><%= match.home_source %></span>
                        <% end %>
                      </div>
                      <% if has_score %>
                        <span class="bracket-team-score"><%= prediction.home_score %></span>
                      <% end %>
                    </div>
                    <div class="bracket-team <%= winner == match.away_team ? 'winner' : '' %>">
                      <div class="bracket-team-info">
                        <% if match.away_team %>
                          <%= flag_icon(match.away_team) %>
                          <span><%= match.away_team.name %></span>
                          <%= lineup_icon(match.away_team, @simulation, match: match) %>
                        <% else %>
                          <span class="bracket-tbd"><%= match.away_source %></span>
                        <% end %>
                      </div>
                      <% if has_score %>
                        <span class="bracket-team-score"><%= prediction.away_score %></span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% else %>
      <div class="card text-center">
        <p class="text-muted"><%= t('bracket.empty_state_complete') %></p>
      </div>
    <% end %>
  </main>
</div>
