<% %w[round_of_32 round_of_16 quarter_final semi_final third_place final].each do |round| %>
  <% matches = @matches_by_round[round] %>
  <% next unless matches&.any? %>

  <section class="bracket-section">
    <h3 class="bracket-round-title"><%= t("bracket.rounds.#{round.gsub('round_of_', 'r')}") %></h3>

    <div class="bracket-matches">
      <% matches.each do |match| %>
        <% prediction = @predictions[match.id] %>
        <% has_winner = prediction&.home_score && prediction&.away_score %>
        <% winner = has_winner ? (prediction.home_score > prediction.away_score ? match.home_team : match.away_team) : nil %>

        <div class="bracket-match">
          <div class="bracket-match-header">
            <span><%= t('bracket.match_number') %> #<%= match.match_number %></span>
            <% if has_winner %>
              <span style="color: var(--color-success);">✓ <%= t('bracket.status.completed') %></span>
            <% elsif match.teams_known? %>
              <span style="color: var(--color-warning);"><%= t('bracket.status.to_play') %></span>
            <% else %>
              <span class="text-muted"><%= t('bracket.status.pending') %></span>
            <% end %>
          </div>
          <div class="bracket-match-content">
            <!-- Home Team -->
            <% if match.home_team %>
              <% is_winner = winner == match.home_team %>
              <% can_click = match.teams_known? && !has_winner %>
              <% if can_click %>
                <%= link_to set_quick_winner_path(token: @simulation.token, match_number: match.match_number, winner_team_id: match.home_team.id),
                            data: { turbo_method: :patch },
                            class: "bracket-team clickable #{is_winner ? 'winner' : ''}" do %>
                  <div class="bracket-team-info">
                    <%= flag_icon(match.home_team) %>
                    <span><%= match.home_team.name %></span>
                  </div>
                <% end %>
              <% else %>
                <div class="bracket-team <%= is_winner ? 'winner' : '' %>">
                  <div class="bracket-team-info">
                    <%= flag_icon(match.home_team) %>
                    <span><%= match.home_team.name %></span>
                  </div>
                  <% if is_winner %>
                    <span style="color: var(--color-success);">👑</span>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="bracket-team">
                <div class="bracket-team-info">
                  <span class="bracket-tbd"><%= match.home_source %></span>
                </div>
              </div>
            <% end %>

            <!-- Away Team -->
            <% if match.away_team %>
              <% is_winner = winner == match.away_team %>
              <% can_click = match.teams_known? && !has_winner %>
              <% if can_click %>
                <%= link_to set_quick_winner_path(token: @simulation.token, match_number: match.match_number, winner_team_id: match.away_team.id),
                            data: { turbo_method: :patch },
                            class: "bracket-team clickable #{is_winner ? 'winner' : ''}" do %>
                  <div class="bracket-team-info">
                    <%= flag_icon(match.away_team) %>
                    <span><%= match.away_team.name %></span>
                  </div>
                <% end %>
              <% else %>
                <div class="bracket-team <%= is_winner ? 'winner' : '' %>">
                  <div class="bracket-team-info">
                    <%= flag_icon(match.away_team) %>
                    <span><%= match.away_team.name %></span>
                  </div>
                  <% if is_winner %>
                    <span style="color: var(--color-success);">👑</span>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="bracket-team">
                <div class="bracket-team-info">
                  <span class="bracket-tbd"><%= match.away_source %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
