<% content_for :title, "#{t('site.title')} - #{t('site.description')}" %>

<div class="page">
  <%= page_title_bar t('simulation.title'), highlight: t('simulation.title_highlight') %>

  <main class="page-content">
    <% if flash[:alert] %>
      <div class="alert alert-warning mb-md">
        <span class="alert-icon">⚠️</span>
        <div class="alert-content"><%= flash[:alert] %></div>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="alert alert-success mb-md">
        <span class="alert-icon">✓</span>
        <div class="alert-content"><%= flash[:notice] %></div>
      </div>
    <% end %>

    <!-- Progress -->
    <div class="progress-container">
      <div class="progress-label">
        <span><%= t('simulation.progress_label') %></span>
        <span><%= @group_progress[:completed] %> / <%= @group_progress[:total] %> <%= t('simulation.matches') %></span>
      </div>
      <div class="progress-bar">
        <% progress_percent = @group_progress[:total] > 0 ? (@group_progress[:completed].to_f / @group_progress[:total] * 100).round : 0 %>
        <div class="progress-fill" style="width: <%= progress_percent %>%;"></div>
      </div>
    </div>

    <!-- Group Stage Section -->
    <section class="page-section">
      <h2 class="section-title"><%= t('simulation.group_stage') %></h2>

      <% if @simulation.quick_mode? %>
        <p class="text-muted mb-md"><%= t('simulation.instructions.quick') %></p>
      <% else %>
        <p class="text-muted mb-md"><%= t('simulation.instructions.complete') %></p>
      <% end %>

      <div class="groups-grid">
        <% @groups.each do |group| %>
          <%
            group_path_url = @simulation.quick_mode? ? quick_group_path(token: @simulation.token, name: group.name) : group_path(@simulation.token, group.name)
            standings = @group_standings[group.id]
            is_complete = @group_completion[group.id]
          %>
          <%= link_to group_path_url, class: "group-card #{'group-card-complete' if is_complete}" do %>
            <div class="group-card-header">
              <div class="group-name"><%= t('simulation.group') %> <span><%= group.name %></span></div>
              <% if is_complete %>
                <span class="group-status complete"><%= t('simulation.complete_status') %></span>
              <% end %>
            </div>
            <div class="group-teams">
              <% if is_complete && standings.any? %>
                <% standings.each_with_index do |row, index| %>
                  <div class="group-team group-team-ranked group-team-position-<%= index + 1 %>">
                    <span class="group-team-rank"><%= index + 1 %></span>
                    <%= flag_icon(row.team, size: :small) %>
                    <span class="group-team-name"><%= row.team.name %></span>
                    <span class="group-team-points"><%= row.points %> <%= t('simulation.pts') %></span>
                  </div>
                <% end %>
              <% else %>
                <% group.teams.limit(4).each do |team| %>
                  <div class="group-team">
                    <%= flag_icon(team, size: :small) %>
                    <span><%= team.name %></span>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>

    <!-- Knockout Stage Section -->
    <section class="page-section">
      <h2 class="section-title"><%= t('simulation.knockout_stage') %></h2>

      <% if @simulation.quick_mode? %>
        <div class="card" style="max-width: 500px;">
          <% if @all_groups_complete %>
            <p class="mb-md"><%= t('simulation.all_complete') %></p>
            <%= link_to quick_third_place_path(token: @simulation.token), class: "btn btn-outline", style: "width: 100%; margin-bottom: var(--space-sm);" do %>
              <%= t('simulation.select_third') %>
            <% end %>
            <%= link_to quick_bracket_path(token: @simulation.token), class: "btn btn-gold", style: "width: 100%;" do %>
              <%= t('simulation.view_bracket') %>
            <% end %>
          <% else %>
            <% completed_count = @group_completion.values.count(true) %>
            <p class="mb-md"><%= t('simulation.complete_first') %> (<%= t('simulation.complete_count', completed: completed_count) %>)</p>
            <button class="btn btn-outline" style="width: 100%; margin-bottom: var(--space-sm);" disabled>
              <%= t('simulation.select_third') %>
            </button>
            <%= link_to quick_bracket_path(token: @simulation.token), class: "btn btn-outline", style: "width: 100%;" do %>
              <%= t('simulation.preview_bracket') %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="card" style="max-width: 500px;">
          <p class="mb-md"><%= t('simulation.bracket_available') %></p>
          <%= link_to bracket_path(token: @simulation.token), class: "btn btn-gold" do %>
            <%= t('simulation.view_bracket_full') %>
          <% end %>
        </div>
      <% end %>
    </section>

    <!-- Actions -->
    <div class="text-center mt-lg">
      <%= link_to root_path, class: "btn btn-outline" do %>
        <%= t('simulation.new_simulation') %>
      <% end %>
    </div>
  </main>
</div>
