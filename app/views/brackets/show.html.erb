<h1>Phase finale - Coupe du Monde 2026</h1>

<p><%= link_to "Retour aux groupes", simulation_path(token: @simulation.token) %></p>

<% unless @qualification[:complete] %>
  <div class="warning">
    <strong>Attention :</strong> La phase de groupes n'est pas complete.
    Completez toutes les predictions de groupe pour voir le bracket final.
    <br>
    <small>
      Matchs predits : <%= Prediction.where(simulation: @simulation).where.not(home_score: nil).count %> / 72
    </small>
  </div>
<% end %>

<h2>Classement des 3emes</h2>
<p>Les 8 meilleures equipes 3emes se qualifient pour les 8emes de finale.</p>

<table border="1" cellpadding="5" cellspacing="0">
  <thead>
    <tr>
      <th>Rang</th>
      <th>Groupe</th>
      <th>Equipe</th>
      <th>Pts</th>
      <th>Diff</th>
      <th>BP</th>
      <th>BC</th>
      <th>Statut</th>
    </tr>
  </thead>
  <tbody>
    <% @qualification[:all_thirds].each_with_index do |third, i| %>
      <tr style="<%= i < 8 ? 'background-color: #d4edda;' : 'background-color: #f8d7da;' %>">
        <td><%= i + 1 %></td>
        <td><%= third.group %></td>
        <td>
          <% if third.team %>
            <%= flag_icon(third.team) %> <%= third.team.name %>
          <% else %>
            TBD
          <% end %>
        </td>
        <td><%= third.points %></td>
        <td><%= third.goal_diff %></td>
        <td><%= third.goals_for %></td>
        <td><%= third.goals_against %></td>
        <td><%= i < 8 ? "Qualifie" : "Elimine" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<hr>

<% if @knockout_matches.any? %>
  <h2>Tableau final</h2>

  <% %w[round_of_32 round_of_16 quarter_final semi_final third_place final].each do |round| %>
    <% matches = @matches_by_round[round] %>
    <% next unless matches&.any? %>

    <h3><%= Match::ROUND_NAMES[round] || round.titleize %></h3>

    <table border="1" cellpadding="5" cellspacing="0">
      <thead>
        <tr>
          <th>#</th>
          <th>Domicile</th>
          <th>Score</th>
          <th>Exterieur</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% matches.each do |match| %>
          <% prediction = @predictions[match.id] %>
          <tr>
            <td><%= match.match_number %></td>
            <td>
              <% if match.home_team %>
                <%= flag_icon(match.home_team) %> <%= match.home_team.name %>
              <% else %>
                <em><%= match.home_source %></em>
              <% end %>
            </td>
            <td>
              <% if prediction&.home_score && prediction&.away_score %>
                <strong><%= prediction.home_score %> - <%= prediction.away_score %></strong>
              <% else %>
                - : -
              <% end %>
            </td>
            <td>
              <% if match.away_team %>
                <%= flag_icon(match.away_team) %> <%= match.away_team.name %>
              <% else %>
                <em><%= match.away_source %></em>
              <% end %>
            </td>
            <td>
              <% if match.teams_known? %>
                <%= link_to "Predire", knockout_match_path(token: @simulation.token, match_number: match.match_number) %>
              <% else %>
                <em>En attente</em>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

<% else %>
  <p><em>Le bracket sera genere une fois la phase de groupes completee.</em></p>
<% end %>
