<% content_for :title, "#{@match.round_name} - World Cup 2026" %>

<div class="page">
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title"><%= @match.round_name.upcase %></h1>
    </div>
  </header>

  <main class="page-content">
    <%= link_to bracket_path(token: @simulation.token), class: "back-link" do %>
      Retour au bracket
    <% end %>

    <% unless @match.teams_known? %>
      <div class="alert alert-warning mb-lg">
        <span class="alert-icon">⚠️</span>
        <div class="alert-content">
          <strong>Équipes non déterminées</strong>
          Les équipes de ce match ne sont pas encore connues.
        </div>
      </div>
    <% end %>

    <% if @match.teams_known? %>
      <div class="prediction-form">
        <div class="prediction-card">
          <% if @prediction.errors.any? %>
            <div class="alert alert-danger mb-md">
              <ul style="margin: 0; padding-left: 20px;">
                <% @prediction.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @prediction,
                        url: update_knockout_match_path(token: @simulation.token, match_number: @match.match_number),
                        method: :patch do |f| %>

            <div class="prediction-teams">
              <div class="prediction-team">
                <%= flag_icon(@match.home_team, size: :large) %>
                <div class="team-name"><%= @match.home_team.name %></div>
                <%= f.number_field :home_score, min: 0, max: 20, placeholder: "0" %>
              </div>

              <div class="prediction-separator">-</div>

              <div class="prediction-team">
                <%= flag_icon(@match.away_team, size: :large) %>
                <div class="team-name"><%= @match.away_team.name %></div>
                <%= f.number_field :away_score, min: 0, max: 20, placeholder: "0" %>
              </div>
            </div>

            <p class="text-muted text-center mb-md" style="font-size: 0.9rem;">
              En cas d'égalité, l'équipe à domicile sera déclarée vainqueur.
            </p>

            <div class="prediction-submit">
              <%= f.submit "Enregistrer la prédiction", class: "btn btn-gold" %>
            </div>

          <% end %>
        </div>
      </div>
    <% end %>
  </main>
</div>
